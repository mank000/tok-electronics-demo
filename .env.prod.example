# Скопируйте в .env.prod и задайте собственный постоянный домен с DNS на сервер.
SITE_DOMAIN=shop.example.com
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_SECRET_KEY=
DJANGO_HSTS_SECONDS=3600
POSTGRES_DB=electroshop
POSTGRES_USER=electroshop
POSTGRES_PASSWORD=
DEMO_PAYMENTS=0
DJANGO_ALLOW_TEST_PAYMENTS=0
# Если бот ещё не настроен, профиль bot можно не запускать.
BOT_TOKEN=
BOT_USERNAME=
BOT_APP_SHORT_NAME=
PUBLIC_BASE_URL=https://shop.example.com
SHOP_CHAT_ID=
PAYMENT_WEBHOOK_SECRET=
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# В текущей версии приложения допускаются только реквизиты тестового магазина.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
